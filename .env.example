# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — MUST be a stable random string (openssl rand -hex 32).
# This is THE most important variable for admin login: if it is missing or
# changes between restarts, users are logged out with "no matching decryption
# secret" and stuck in a login loop. Set it in your hosting environment.
AUTH_SECRET="replace-with-a-random-64-char-hex-string"
AUTH_URL="https://yourdomain.com"
AUTH_TRUST_HOST="true"

# Protects the public /api/seed and /api/revalidate endpoints.
# When unset these endpoints are DISABLED.
SEED_SECRET="replace-with-openssl-rand-hex-32"
REVALIDATE_SECRET="replace-with-openssl-rand-hex-32"

# Admin Initial Setup (one-time use, change password after first login)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe@123"

# Cloudinary (Media Library) — optional
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend) — optional; falls back to in-app notifications
RESEND_API_KEY=""
EMAIL_FROM="YourCompany <noreply@yourdomain.com>"

# Site
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="911234567890"
NEXT_PUBLIC_SITE_NAME="YourCompany"

# Analytics (optional)
GOOGLE_ANALYTICS_ID=""

# Monitoring (optional)
SENTRY_DSN=""

# Groq AI (RAG / AI Assistant / AI content generation)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"