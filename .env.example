# ============================================
# AIOpsMedia — Environment Variables
# Copy this file to .env for local dev, and paste
# the values into your Hostinger production env.
# ============================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js (IMPORTANT for admin login)
# Generate a real secret with: npx auth secret
AUTH_SECRET="replace-with-output-of-npx-auth-secret"
AUTH_URL="https://aiopsmedia.com"
AUTH_TRUST_HOST="true"

# Admin Initial Setup (one-time use, change password after first login)
ADMIN_EMAIL="admin@aiopsmedia.com"
ADMIN_PASSWORD="ChangeThis@123"

# Cloudinary (Media Library)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="AIOpsMedia <noreply@aiopsmedia.com>"

# Site
NEXT_PUBLIC_SITE_URL="https://aiopsmedia.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="916203818011"
NEXT_PUBLIC_SITE_NAME="AIOpsMedia"

# Analytics
GOOGLE_ANALYTICS_ID=""

# Monitoring
SENTRY_DSN=""

# Groq AI (RAG / AI Assistant / AI content generation)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"